# TaskFlow Root Environment Template
# Copy this file to .env or workspace-specific .env files for local development.

# Global
NODE_ENV=development

# Backend API (apps/api)
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=super-secret-taskflow-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECRET=super-secret-taskflow-cookie-key-replace-in-production-min-32-chars
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Database Configuration (Prisma / PostgreSQL / Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskflow_dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow_dev?schema=public"

# Internal Python AI Service (apps/ai)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=taskflow-internal-dev-token
AI_SERVICE_TIMEOUT_MS=30000

# Upstream LLM Configuration (never committed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend Web (apps/web)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=TaskFlow
