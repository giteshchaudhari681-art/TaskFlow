# TaskFlow API Environment Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Authentication (PR 3 Production Session Engine)
JWT_SECRET=development-jwt-secret-min-32-chars-for-taskflow-api
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECRET=development-cookie-secret-min-32-chars-taskflow

# Database Configuration (Prisma / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow_dev?schema=public"
