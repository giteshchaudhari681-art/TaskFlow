{
  "name": "taskflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "TaskFlow — AI-Powered Project Operations Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@taskflow/shared && npm run build --workspace=@taskflow/validation",
    "build": "npm run build:packages && npm run build --workspace=@taskflow/api && npm run build --workspace=@taskflow/web",
    "dev:api": "npm run dev --workspace=@taskflow/api",
    "dev:web": "npm run dev --workspace=@taskflow/web",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run build:packages && npm run type-check --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "npm run prisma:generate --workspace=@taskflow/api",
    "prisma:validate": "npm run prisma:validate --workspace=@taskflow/api",
    "prisma:format": "npm run prisma:format --workspace=@taskflow/api",
    "prisma:format:check": "npm run prisma:format:check --workspace=@taskflow/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@taskflow/api",
    "prisma:seed": "npm run prisma:seed --workspace=@taskflow/api",
    "test": "npm run test --workspace=@taskflow/api",
    "ai:eval": "python apps/ai/evals/runner.py",
    "ai:eval:live": "python apps/ai/evals/runner.py --live",
    "test:ai:eval": "npm run test --workspace=@taskflow/api -- src/__tests__/ai_evaluation_reliability.test.ts --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "TaskFlow Team",
  "license": "MIT"
}
