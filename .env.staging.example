# ============================================================================
# TaskFlow Staging Environment Configuration Contract
# ============================================================================
# IMPORTANT:
# 1. This file is an example template for staging deployments.
# 2. Never commit actual secret values to this or any repository file.
# 3. In staging (NODE_ENV=staging), secrets must satisfy minimum length rules:
#    - JWT_SECRET: >= 32 characters
#    - COOKIE_SECRET: >= 32 characters
#    - AI_SERVICE_TOKEN: >= 16 characters
#    - CORS_ORIGIN: fully-qualified origin (no wildcards)
#    - DATABASE_URL: must not use default dev credentials
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Public Application Configuration
# ----------------------------------------------------------------------------
NODE_ENV=staging
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=https://staging.taskflow.dev

# ----------------------------------------------------------------------------
# 2. API Secrets (Must be at least 32 characters long in staging)
# ----------------------------------------------------------------------------
# Generate via: openssl rand -base64 32
JWT_SECRET=LJPsoMwBmtEuomvc79j3PuDbSq/qBpwPNKjflSOWvg8=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
# Generate via: openssl rand -base64 32
COOKIE_SECRET=qfdCtfhWnyHofiVNWX4NETIL1Er+G09M5oDpqMSzvNg=

# ----------------------------------------------------------------------------
# 3. Database Credentials (PostgreSQL 16+)
# ----------------------------------------------------------------------------
# Used by docker-compose.staging.yml
POSTGRES_USER=postgres
# Generate strong password (min 16 chars): openssl rand -base64 24
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskflow_staging

# Connection string used by TaskFlow API and Worker:
DATABASE_URL="postgresql://neondb_owner:npg_6aWwL1MTcvgN@ep-winter-smoke-b3gzayyk-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ----------------------------------------------------------------------------
# 4. Internal AI Service Token & Configuration
# ----------------------------------------------------------------------------
# Shared internal secret (min 16 chars). Never exposed to browser or public network.
AI_SERVICE_TOKEN=6aDBWw3CuzJERCz0ukeC98aV2/uDkCoFuwCj6RmzVqE=
AI_SERVICE_URL=http://taskflow-ai:8000
AI_SERVICE_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# 5. Sentry Observability & Error Monitoring
# ----------------------------------------------------------------------------
# Sentry project DSN for error telemetry (optional; disabled if empty)
SENTRY_DSN=https://fd715e4be736e18129d3b38266fe083b@o4512219394015232.ingest.us.sentry.io/4512219410726912
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# 6. Python AI & OpenAI Configuration (Internal to taskflow-ai)
# ----------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
APP_ENV=staging
AI_REQUEST_TIMEOUT_SECONDS=30.0
# Live OpenAI API Key (optional in staging; automated tests use mock provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# 7. Worker & Background Job Configuration
# ----------------------------------------------------------------------------
WORKER_POLLING_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=1000
WORKER_RETRY_MAX_DELAY_MS=60000
WORKER_PROCESSING_TIMEOUT_MS=30000
WORKER_SHUTDOWN_GRACE_PERIOD_MS=10000

# ----------------------------------------------------------------------------
# 8. Cloudinary Storage Configuration (Optional)
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=n4wzxvht
CLOUDINARY_API_KEY=723892697766277
CLOUDINARY_API_SECRET=x1u3smsHa4uLzr_qqfHoYNGfRKg
